# ============================================================
# METRIQ PRO - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para ".env" e preencha os valores.
# O aplicativo carrega o .env automaticamente (run.py e ai_client.py).
#
#   cp .env.example .env    (Linux/Mac)
#   copy .env.example .env  (Windows - usado no console)
#
# ATENÇÃO: NUNCA envie o arquivo .env para o repositório/Git.
# ============================================================

# ------------------------------------------------------------
# CHAVE DA IA (OBRIGATÓRIA para análises por IA)
# ------------------------------------------------------------
# A IA precisa de pelo menos UMA chave válida. Configure a Groq
# (recomendada: rápida e gratuita) e/ou a Google (Gemini).
#
# ◆ GROQ:  https://console.groq.com  → API Keys → Criar chave
# ◆ GOOGLE: https://aistudio.google.com → API key (Gemini)
# ------------------------------------------------------------
GROQ_API_KEY=cole_aqui_sua_chave_groq
# GOOGLE_API_KEY=cole_aqui_sua_chave_google

# ------------------------------------------------------------
# SEGURANÇA (obrigatório em produção)
# ------------------------------------------------------------
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_esta_chave_secreta

# ------------------------------------------------------------
# E-MAIL (para confirmação e recuperação de senha)
# ------------------------------------------------------------
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=seuemail@gmail.com
# MAIL_PASSWORD=sua_senha_de_app
# MAIL_DEFAULT_SENDER=seuemail@gmail.com

# ------------------------------------------------------------
# BANCO DE DADOS (opcional - padrão usa SQLite local)
# ------------------------------------------------------------
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
